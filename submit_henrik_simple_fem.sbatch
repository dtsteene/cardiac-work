#!/bin/bash
# ==============================================================================
# FEM dispatcher — Henrik's simple PUL-only Regazzoni defaults (no Optuna)
# ==============================================================================
# Submits a FEM coupled run for each of the 5 factor cases generated by
# gen_henrik_simple_params.py. Each FEM job is 6 beats with POST_FULL=1
# so the directional work decomposition is computed.
#
# Purpose: see whether minimal-knob 0D parameter sweeps that work fine
# in the standalone 0D break under FEM coupling because (a) 0D V_RV
# blows up to ~288 mL while the UKB mesh holds RV at 77 mL, and (b) 0D
# LV pressure drifts down with severity, mirroring the artefact we saw
# in the old data calibration.
# ==============================================================================

#SBATCH --job-name=fem_dispha
#SBATCH --partition=habanaq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --time=0:10:00
#SBATCH --output=fem_dispatch_henrik_%j.out
#SBATCH --error=fem_dispatch_henrik_%j.err

WORK_DIR="/global/D1/homes/dtsteene/cardiac-work"
DATA_DIR="${WORK_DIR}/data/henrik_simple_pul"
CASES="pul_f100 pul_f075 pul_f050 pul_f025 pul_f010"

cd "$WORK_DIR"

echo "============================================================"
echo "  FEM dispatch — Henrik simple PUL sweep (Regazzoni defaults)"
echo "  Started : $(date)"
echo "  POST_FULL=1"
echo "============================================================"

JOB_IDS=()
for sev in $CASES; do
    JSON="$DATA_DIR/henrik_simple_pul_${sev}.json"
    [ ! -f "$JSON" ] && { echo "MISSING: $JSON"; continue; }
    echo "  Submitting FEM $sev"
    JID=$(sbatch --parsable \
        --export=ALL,MESH=UKB,BEATS=6,POST_FULL=1,\
CIRCULATION_PARAMS="$JSON",COMMENT="henrik_simple_${sev}_6bt" \
        run_sim_and_post.sbatch)
    [ -n "$JID" ] && { JOB_IDS+=("$JID"); echo "    → $JID"; }
done

echo ""
echo "Submitted ${#JOB_IDS[@]} FEM jobs: ${JOB_IDS[@]}"
echo "Finished: $(date)"
